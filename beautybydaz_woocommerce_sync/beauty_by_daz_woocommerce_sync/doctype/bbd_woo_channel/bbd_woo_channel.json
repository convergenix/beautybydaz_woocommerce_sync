{
  "doctype": "DocType",
  "name": "BBD Woo Channel",
  "module": "Beauty By Daz WooCommerce Sync",
  "custom": 0,
  "autoname": "field:alias",
  "title_field": "alias",
  "field_order": ["alias", "enabled", "base_url", "consumer_key", "consumer_secret", "workflow_section", "order_sync_enabled", "refund_sync_enabled", "price_sync_enabled", "stock_sync_enabled", "new_item_sync_enabled", "erp_section", "company", "warehouse", "price_list", "customer_group", "income_account", "shipping_income_account", "cost_center", "default_category_id", "order_floor", "allow_negative_stock_on_paid_orders", "technical_section", "timeout_seconds", "max_retries", "last_poll_at"],
  "fields": [
    {"fieldname": "alias", "label": "Alias", "fieldtype": "Data", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "enabled", "label": "Enabled", "fieldtype": "Check", "default": "0", "in_list_view": 1},
    {"fieldname": "base_url", "label": "WooCommerce Base URL", "fieldtype": "Data", "reqd": 1},
    {"fieldname": "consumer_key", "label": "Consumer Key", "fieldtype": "Password", "reqd": 1},
    {"fieldname": "consumer_secret", "label": "Consumer Secret", "fieldtype": "Password", "reqd": 1},
    {"fieldname": "workflow_section", "label": "Workflows", "fieldtype": "Section Break"},
    {"fieldname": "order_sync_enabled", "label": "Paid Order Sync", "fieldtype": "Check", "default": "1"},
    {"fieldname": "refund_sync_enabled", "label": "Refund Sync", "fieldtype": "Check", "default": "1"},
    {"fieldname": "price_sync_enabled", "label": "Price Sync", "fieldtype": "Check", "default": "1"},
    {"fieldname": "stock_sync_enabled", "label": "Stock Sync", "fieldtype": "Check", "default": "1"},
    {"fieldname": "new_item_sync_enabled", "label": "New Item Draft Sync", "fieldtype": "Check", "default": "1"},
    {"fieldname": "erp_section", "label": "ERP Routing", "fieldtype": "Section Break"},
    {"fieldname": "company", "label": "Company", "fieldtype": "Link", "options": "Company", "reqd": 1},
    {"fieldname": "warehouse", "label": "Warehouse", "fieldtype": "Link", "options": "Warehouse", "reqd": 1},
    {"fieldname": "price_list", "label": "Price List", "fieldtype": "Link", "options": "Price List", "reqd": 1},
    {"fieldname": "customer_group", "label": "Customer Group", "fieldtype": "Link", "options": "Customer Group", "reqd": 1},
    {"fieldname": "income_account", "label": "Income Account", "fieldtype": "Link", "options": "Account", "reqd": 1},
    {"fieldname": "shipping_income_account", "label": "Shipping Income Account", "fieldtype": "Link", "options": "Account"},
    {"fieldname": "cost_center", "label": "Cost Center", "fieldtype": "Link", "options": "Cost Center", "reqd": 1},
    {"fieldname": "default_category_id", "label": "Default Woo Category ID", "fieldtype": "Int"},
    {"fieldname": "order_floor", "label": "Minimum Woo Order ID", "fieldtype": "Int", "default": "0"},
    {"fieldname": "allow_negative_stock_on_paid_orders", "label": "Allow Negative Stock on Paid Orders", "fieldtype": "Check", "default": "0", "description": "Records paid Woo oversells as negative stock without changing the global Stock Settings policy."},
    {"fieldname": "technical_section", "label": "Technical", "fieldtype": "Section Break"},
    {"fieldname": "timeout_seconds", "label": "HTTP Timeout Seconds", "fieldtype": "Int", "default": "45"},
    {"fieldname": "max_retries", "label": "Maximum Retries", "fieldtype": "Int", "default": "3"},
    {"fieldname": "last_poll_at", "label": "Last Poll At", "fieldtype": "Datetime", "read_only": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Stock Manager", "read": 1},
    {"role": "Accounts Manager", "read": 1}
  ]
}
